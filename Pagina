<!DOCTYPE html>
<html lang="es" x-data="app()" x-init="init()">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title x-text="config.platformName || 'TaskCult'">TaskCult</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --bg-base: #080c10;
      --bg-surface: #0d1117;
      --bg-elevated: #131920;
      --bg-overlay: #1a2232;
      --border: #1e2d3d;
      --border-subtle: #162030;
      --text-primary: #e8edf3;
      --text-secondary: #7a8fa8;
      --text-muted: #3d5069;
      --accent: #6366f1;
      --accent-soft: #4f46e5;
      --accent-glow: rgba(99,102,241,0.15);
      --teal: #0d9488;
      --teal-soft: rgba(13,148,136,0.12);
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;
    }
    * { box-sizing: border-box; }
    body {
      background-color: var(--bg-base);
      color: var(--text-primary);
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      line-height: 1.6;
      min-height: 100vh;
    }
    h1,h2,h3,h4,h5,h6,.font-display { font-family: 'Syne', sans-serif; }
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: var(--bg-base); }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--text-muted); }
    .glass { background: rgba(13,17,23,0.7); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid var(--border); }
    .glass-elevated { background: rgba(19,25,32,0.85); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid var(--border); }
    .btn-primary { background: linear-gradient(135deg, var(--accent), var(--accent-soft)); color: white; font-family: 'Syne', sans-serif; font-weight: 600; letter-spacing: 0.02em; transition: all 0.2s ease; box-shadow: 0 0 20px rgba(99,102,241,0.3); cursor: pointer; border: none; }
    .btn-primary:hover { box-shadow: 0 0 30px rgba(99,102,241,0.5); transform: translateY(-1px); }
    .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
    .btn-ghost { background: transparent; border: 1px solid var(--border); color: var(--text-secondary); font-family: 'Syne', sans-serif; font-weight: 500; transition: all 0.2s ease; cursor: pointer; }
    .btn-ghost:hover { border-color: var(--accent); color: var(--text-primary); background: var(--accent-glow); }
    .btn-teal { background: linear-gradient(135deg, var(--teal), #0f766e); color: white; font-family: 'Syne', sans-serif; font-weight: 600; transition: all 0.2s ease; box-shadow: 0 0 20px rgba(13,148,136,0.25); cursor: pointer; border: none; }
    .btn-teal:hover { box-shadow: 0 0 30px rgba(13,148,136,0.4); transform: translateY(-1px); }
    .nav-item { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-radius: 8px; color: var(--text-secondary); font-family: 'Syne', sans-serif; font-weight: 500; font-size: 13px; cursor: pointer; transition: all 0.15s ease; border: 1px solid transparent; }
    .nav-item:hover { background: var(--bg-overlay); color: var(--text-primary); border-color: var(--border-subtle); }
    .nav-item.active { background: var(--accent-glow); color: #a5b4fc; border-color: rgba(99,102,241,0.3); }
    .task-card { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 12px; transition: all 0.25s ease; cursor: pointer; overflow: hidden; }
    .task-card:hover { border-color: rgba(99,102,241,0.4); box-shadow: 0 8px 32px rgba(0,0,0,0.4), 0 0 0 1px rgba(99,102,241,0.1); transform: translateY(-2px); }
    .subject-pill { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-family: 'Syne', sans-serif; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; }
    .level-badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 4px; font-size: 10px; font-family: 'Syne', sans-serif; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; background: var(--bg-overlay); color: var(--text-muted); border: 1px solid var(--border); }
    .input-field { background: var(--bg-base); border: 1px solid var(--border); color: var(--text-primary); border-radius: 8px; padding: 10px 14px; font-family: 'DM Sans', sans-serif; font-size: 14px; width: 100%; transition: border-color 0.15s ease, box-shadow 0.15s ease; outline: none; }
    .input-field:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(99,102,241,0.1); }
    .input-field::placeholder { color: var(--text-muted); }
    select.input-field option { background: var(--bg-elevated); }
    .points-badge { background: linear-gradient(135deg, rgba(99,102,241,0.15), rgba(79,70,229,0.1)); border: 1px solid rgba(99,102,241,0.3); color: #a5b4fc; padding: 3px 10px; border-radius: 20px; font-family: 'Syne', sans-serif; font-weight: 700; font-size: 12px; }
    .mesh-bg { background-image: radial-gradient(ellipse at 20% 20%, rgba(99,102,241,0.06) 0%, transparent 60%), radial-gradient(ellipse at 80% 80%, rgba(13,148,136,0.04) 0%, transparent 60%); }
    .stat-card { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 10px; padding: 16px; }
    .toast { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: var(--bg-overlay); border: 1px solid var(--border); border-radius: 10px; padding: 12px 18px; font-family: 'DM Sans', sans-serif; font-size: 13px; box-shadow: 0 8px 32px rgba(0,0,0,0.5); display: flex; align-items: center; gap: 10px; animation: slideUp 0.3s ease; max-width: 320px; }
    @keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.75); backdrop-filter: blur(6px); z-index: 500; display: flex; align-items: center; justify-content: center; padding: 16px; }
    .modal-box { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 16px; width: 100%; max-width: 560px; max-height: 90vh; overflow-y: auto; animation: modalIn 0.25s ease; }
    @keyframes modalIn { from { transform: scale(0.95); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    .tag { background: var(--bg-overlay); border: 1px solid var(--border); color: var(--text-secondary); padding: 3px 10px; border-radius: 6px; font-size: 11px; font-family: 'Syne', sans-serif; font-weight: 500; }
    .progress-bar { background: var(--border); border-radius: 4px; height: 4px; overflow: hidden; }
    .progress-fill { height: 100%; background: linear-gradient(90deg, var(--accent), var(--teal)); border-radius: 4px; transition: width 0.5s ease; }
    @media (max-width: 768px) { .sidebar-desktop { display: none; } }
    @media (min-width: 769px) { .mobile-nav { display: none; } }
    .subject-math { background: rgba(99,102,241,0.12); color: #a5b4fc; border: 1px solid rgba(99,102,241,0.25); }
    .subject-physics { background: rgba(6,182,212,0.12); color: #67e8f9; border: 1px solid rgba(6,182,212,0.25); }
    .subject-chemistry { background: rgba(245,158,11,0.12); color: #fcd34d; border: 1px solid rgba(245,158,11,0.25); }
    .subject-history { background: rgba(239,68,68,0.12); color: #fca5a5; border: 1px solid rgba(239,68,68,0.25); }
    .subject-literature { background: rgba(168,85,247,0.12); color: #d8b4fe; border: 1px solid rgba(168,85,247,0.25); }
    .subject-biology { background: rgba(16,185,129,0.12); color: #6ee7b7; border: 1px solid rgba(16,185,129,0.25); }
    .subject-programming { background: rgba(13,148,136,0.12); color: #5eead4; border: 1px solid rgba(13,148,136,0.25); }
    .subject-english { background: rgba(251,146,60,0.12); color: #fdba74; border: 1px solid rgba(251,146,60,0.25); }
    .subject-other { background: rgba(100,116,139,0.12); color: #94a3b8; border: 1px solid rgba(100,116,139,0.25); }
    [x-cloak] { display: none !important; }
    textarea.input-field { resize: vertical; min-height: 90px; }

    /* Loading overlay */
    .loading-overlay { position: fixed; inset: 0; background: rgba(8,12,16,0.85); backdrop-filter: blur(4px); z-index: 9998; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; }
    .spinner { width: 40px; height: 40px; border: 3px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* Setup screen */
    .setup-screen { position: fixed; inset: 0; background: var(--bg-base); z-index: 9997; display: flex; align-items: center; justify-content: center; padding: 24px; }
  </style>
</head>
<body class="mesh-bg">

<!-- LOADING OVERLAY -->
<template x-if="isLoading">
  <div class="loading-overlay">
    <div class="spinner"></div>
    <div class="font-display text-sm" style="color:var(--text-secondary)" x-text="loadingMsg"></div>
  </div>
</template>

<!-- TOAST -->
<template x-if="toast.show">
  <div class="toast" :class="{'border-green-500/30': toast.type==='success', 'border-red-500/30': toast.type==='error', 'border-yellow-500/30': toast.type==='warning'}">
    <span x-show="toast.type==='success'" class="text-green-400 text-base">✓</span>
    <span x-show="toast.type==='error'" class="text-red-400 text-base">✗</span>
    <span x-show="toast.type==='warning'" class="text-yellow-400 text-base">⚠</span>
    <span x-text="toast.message" class="text-sm"></span>
  </div>
</template>

<!-- ===================== JSONBIN SETUP SCREEN ===================== -->
<div x-show="!setupDone && !isLoading" x-cloak class="setup-screen">
  <div class="w-full max-w-lg">
    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-3 mb-4">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background:linear-gradient(135deg,#6366f1,#0d9488)">
          <span class="text-white font-display font-bold text-xl">T</span>
        </div>
        <h1 class="font-display text-3xl font-bold tracking-tight">TaskCult</h1>
      </div>
      <p class="text-sm" style="color:var(--text-secondary)">Configuración inicial del backend JSON</p>
    </div>

    <div class="glass-elevated rounded-2xl p-8 space-y-6">
      <div class="rounded-xl p-4" style="background:rgba(99,102,241,0.08); border:1px solid rgba(99,102,241,0.2)">
        <div class="font-display font-semibold text-sm mb-2" style="color:#a5b4fc">¿Cómo obtener tu API Key de JSONBin?</div>
        <ol class="text-xs space-y-1" style="color:var(--text-secondary)">
          <li>1. Entrá a <a href="https://jsonbin.io" target="_blank" class="text-indigo-400 underline">jsonbin.io</a> y creá una cuenta gratuita</li>
          <li>2. En tu dashboard, andá a <strong>API Keys</strong></li>
          <li>3. Copiá tu <strong>Secret Access Key</strong></li>
          <li>4. Pegala abajo y hacé click en "Inicializar"</li>
        </ol>
      </div>

      <div>
        <label class="block text-xs font-display font-semibold mb-2" style="color:var(--text-secondary)">SECRET ACCESS KEY DE JSONBIN</label>
        <input x-model="setupApiKey" type="password" placeholder="$2b$10$..." class="input-field" @keydown.enter="initializeBackend()"/>
        <p class="text-xs mt-1" style="color:var(--text-muted)">Se guarda localmente solo en tu navegador.</p>
      </div>

      <div x-show="setupError" class="text-sm text-red-400 px-3 py-2 rounded-lg" style="background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.2)" x-text="setupError"></div>

      <button @click="initializeBackend()" :disabled="!setupApiKey || isLoading" class="btn-primary w-full py-3 rounded-xl">
        <span x-show="!isLoading">Inicializar Backend</span>
        <span x-show="isLoading">Conectando...</span>
      </button>

      <p class="text-center text-xs" style="color:var(--text-muted)">
        La cuenta gratuita de JSONBin incluye 10,000 requests/mes — más que suficiente para uso educativo.
      </p>
    </div>
  </div>
</div>

<!-- ===================== AUTH SCREEN ===================== -->
<div x-show="setupDone && !currentUser && !isLoading" x-cloak class="min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md">
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background:linear-gradient(135deg,#6366f1,#0d9488)">
          <span class="text-white font-display font-bold text-lg">T</span>
        </div>
        <h1 class="font-display text-2xl font-bold tracking-tight" x-text="config.platformName || 'TaskCult'"></h1>
      </div>
      <p class="text-sm" style="color:var(--text-secondary)" x-text="config.platformDescription || 'La economía del conocimiento académico'"></p>
    </div>

    <div class="glass-elevated rounded-2xl p-8">
      <div class="flex gap-1 p-1 rounded-xl mb-8" style="background:var(--bg-base)">
        <button @click="authMode='login'" class="flex-1 py-2 rounded-lg text-sm font-display font-semibold transition-all duration-200"
          :class="authMode==='login' ? 'bg-indigo-600 text-white shadow-lg' : 'text-gray-500 hover:text-gray-300'">
          Iniciar Sesión
        </button>
        <button @click="authMode='register'" class="flex-1 py-2 rounded-lg text-sm font-display font-semibold transition-all duration-200"
          :class="authMode==='register' ? 'bg-indigo-600 text-white shadow-lg' : 'text-gray-500 hover:text-gray-300'">
          Registrarse
        </button>
      </div>

      <div x-show="authMode==='login'" class="space-y-4">
        <div>
          <label class="block text-xs font-display font-semibold mb-2" style="color:var(--text-secondary)">USUARIO O EMAIL</label>
          <input x-model="loginForm.username" type="text" placeholder="tu_usuario" class="input-field" @keydown.enter="doLogin()"/>
        </div>
        <div>
          <label class="block text-xs font-display font-semibold mb-2" style="color:var(--text-secondary)">CONTRASEÑA</label>
          <input x-model="loginForm.password" type="password" placeholder="••••••••" class="input-field" @keydown.enter="doLogin()"/>
        </div>
        <button @click="doLogin()" :disabled="isLoading" class="btn-primary w-full py-3 rounded-xl mt-2">
          <span x-show="!isLoading">Entrar a TaskCult</span>
          <span x-show="isLoading">Verificando...</span>
        </button>
        <p class="text-center text-xs" style="color:var(--text-muted)">
          Admin: <span class="text-indigo-400 font-mono">admin / admin123</span>
        </p>
      </div>

      <div x-show="authMode==='register'" class="space-y-4">
        <div>
          <label class="block text-xs font-display font-semibold mb-2" style="color:var(--text-secondary)">NOMBRE DE USUARIO</label>
          <input x-model="registerForm.username" type="text" placeholder="mi_usuario" class="input-field"/>
        </div>
        <div>
          <label class="block text-xs font-display font-semibold mb-2" style="color:var(--text-secondary)">EMAIL</label>
          <input x-model="registerForm.email" type="email" placeholder="tu@email.com" class="input-field"/>
        </div>
        <div>
          <label class="block text-xs font-display font-semibold mb-2" style="color:var(--text-secondary)">NIVEL ACADÉMICO</label>
          <select x-model="registerForm.level" class="input-field">
            <option value="">Seleccionar nivel...</option>
            <template x-for="lvl in academicLevels" :key="lvl"><option :value="lvl" x-text="lvl"></option></template>
          </select>
        </div>
        <div>
          <label class="block text-xs font-display font-semibold mb-2" style="color:var(--text-secondary)">CONTRASEÑA</label>
          <input x-model="registerForm.password" type="password" placeholder="mínimo 6 caracteres" class="input-field"/>
        </div>
        <button @click="doRegister()" :disabled="isLoading" class="btn-primary w-full py-3 rounded-xl mt-2">
          <span x-show="!isLoading">Crear Cuenta</span>
          <span x-show="isLoading">Creando cuenta...</span>
        </button>
        <p class="text-center text-xs" style="color:var(--text-muted)">
          Recibirás <span class="text-indigo-400 font-semibold">100 puntos</span> de bienvenida
        </p>
      </div>
    </div>
  </div>
</div>

<!-- ===================== MAIN APP ===================== -->
<div x-show="setupDone && currentUser && !isLoading" x-cloak class="flex min-h-screen">

  <!-- SIDEBAR -->
  <aside class="sidebar-desktop w-56 flex-shrink-0 flex flex-col" style="background:var(--bg-surface); border-right:1px solid var(--border); position:sticky; top:0; height:100vh; overflow-y:auto;">
    <div class="p-5 pb-4" style="border-bottom:1px solid var(--border)">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background:linear-gradient(135deg,#6366f1,#0d9488)">
          <span class="text-white font-display font-bold text-sm">T</span>
        </div>
        <span class="font-display font-bold text-base" x-text="config.platformName || 'TaskCult'"></span>
      </div>
    </div>
    <div class="p-4">
      <div class="rounded-lg p-3" style="background:var(--accent-glow); border:1px solid rgba(99,102,241,0.2)">
        <div class="text-xs font-display font-semibold mb-1" style="color:var(--text-muted)">TUS PUNTOS</div>
        <div class="text-xl font-display font-bold" style="color:#a5b4fc" x-text="(currentUser?.points || 0).toLocaleString() + ' pts'"></div>
      </div>
    </div>
    <nav class="px-3 flex-1 space-y-1">
      <div @click="setPage('home')" class="nav-item" :class="currentPage==='home'?'active':''"><span class="text-base">🏠</span> Feed</div>
      <div @click="setPage('explore')" class="nav-item" :class="currentPage==='explore'?'active':''"><span class="text-base">🔭</span> Explorar</div>
      <div @click="setPage('upload')" class="nav-item" :class="currentPage==='upload'?'active':''"><span class="text-base">⬆️</span> Subir Tarea</div>
      <div @click="setPage('library')" class="nav-item" :class="currentPage==='library'?'active':''"><span class="text-base">📚</span> Mi Biblioteca</div>
      <div @click="setPage('leaderboard')" class="nav-item" :class="currentPage==='leaderboard'?'active':''"><span class="text-base">🏆</span> Leaderboard</div>
      <div @click="setPage('profile')" class="nav-item" :class="currentPage==='profile'?'active':''"><span class="text-base">👤</span> Perfil</div>
      <template x-if="currentUser?.isAdmin">
        <div>
          <div class="my-3" style="border-top:1px solid var(--border)"></div>
          <div @click="setPage('admin')" class="nav-item" :class="currentPage==='admin'?'active':''"
            style="color:#fbbf24"
            :style="currentPage==='admin' ? 'background:rgba(251,191,36,0.08);border-color:rgba(251,191,36,0.2);color:#fbbf24' : ''">
            <span class="text-base">⚙️</span> Admin Panel
          </div>
        </div>
      </template>
    </nav>
    <div class="p-3 mt-auto" style="border-top:1px solid var(--border)">
      <div class="flex items-center gap-2 p-2 rounded-lg cursor-pointer hover:bg-opacity-50 transition-all" style="background:var(--bg-overlay)" @click="setPage('profile')">
        <img :src="currentUser?.avatar || avatarUrl(currentUser?.username)" class="w-8 h-8 rounded-full object-cover flex-shrink-0"/>
        <div class="flex-1 min-w-0">
          <div class="text-xs font-display font-semibold truncate" x-text="currentUser?.username"></div>
          <div class="text-xs truncate" style="color:var(--text-muted)" x-text="currentUser?.level || 'Estudiante'"></div>
        </div>
        <button @click.stop="doLogout()" class="text-xs hover:text-red-400 transition-colors" style="color:var(--text-muted)" title="Cerrar sesión">✕</button>
      </div>
    </div>
  </aside>

  <!-- MOBILE NAV -->
  <div class="mobile-nav fixed bottom-0 left-0 right-0 z-50" style="background:var(--bg-surface); border-top:1px solid var(--border)">
    <div class="flex items-center justify-around py-2 px-2">
      <button @click="setPage('home')" class="flex flex-col items-center gap-1 px-3 py-1 rounded-lg transition-all" :class="currentPage==='home'?'text-indigo-400':''" style="color:var(--text-muted)">
        <span class="text-lg">🏠</span><span class="text-xs font-display">Feed</span>
      </button>
      <button @click="setPage('explore')" class="flex flex-col items-center gap-1 px-3 py-1 rounded-lg transition-all" :class="currentPage==='explore'?'text-indigo-400':''" style="color:var(--text-muted)">
        <span class="text-lg">🔭</span><span class="text-xs font-display">Explorar</span>
      </button>
      <button @click="setPage('upload')" class="flex flex-col items-center gap-1 px-3 py-1 rounded-lg transition-all btn-primary rounded-xl" style="color:white">
        <span class="text-lg">⬆️</span><span class="text-xs font-display">Subir</span>
      </button>
      <button @click="setPage('library')" class="flex flex-col items-center gap-1 px-3 py-1 rounded-lg transition-all" :class="currentPage==='library'?'text-indigo-400':''" style="color:var(--text-muted)">
        <span class="text-lg">📚</span><span class="text-xs font-display">Biblio</span>
      </button>
      <button @click="setPage('profile')" class="flex flex-col items-center gap-1 px-3 py-1 rounded-lg transition-all" :class="currentPage==='profile'?'text-indigo-400':''" style="color:var(--text-muted)">
        <span class="text-lg">👤</span><span class="text-xs font-display">Perfil</span>
      </button>
    </div>
  </div>

  <!-- MAIN CONTENT -->
  <main class="flex-1 min-w-0 pb-20 md:pb-0">

    <!-- HOME -->
    <div x-show="currentPage==='home'" class="p-4 md:p-8 max-w-4xl mx-auto">
      <div class="mb-8">
        <h2 class="font-display text-2xl font-bold mb-1">Bienvenido, <span style="color:#a5b4fc" x-text="currentUser?.username"></span> 👋</h2>

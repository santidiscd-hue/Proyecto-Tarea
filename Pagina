<script>
// ==============================
// JSONBin API wrapper
// ==============================
const JSONBIN_BASE = 'https://api.jsonbin.io/v3';

async function jbGet(binId, apiKey) {
  const r = await fetch(`${JSONBIN_BASE}/b/${binId}/latest`, {
    headers: { 'X-Master-Key': apiKey }
  });
  if (!r.ok) throw new Error('GET failed: ' + r.status);
  const d = await r.json();
  return d.record;
}

async function jbSet(binId, apiKey, data) {
  const r = await fetch(`${JSONBIN_BASE}/b/${binId}`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json', 'X-Master-Key': apiKey },
    body: JSON.stringify(data)
  });
  if (!r.ok) throw new Error('PUT failed: ' + r.status);
  const d = await r.json();
  return d.record;
}

async function jbCreate(apiKey, data, name) {
  const r = await fetch(`${JSONBIN_BASE}/b`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-Master-Key': apiKey, 'X-Bin-Name': name, 'X-Bin-Private': 'true' },
    body: JSON.stringify(data)
  });
  if (!r.ok) throw new Error('CREATE failed: ' + r.status);
  const d = await r.json();
  return d.metadata.id;
}

// ==============================
// Alpine App
// ==============================
function app() {
  return {
    // State
    isLoading: true,
    loadingMsg: 'Conectando con el backend...',
    setupDone: false,
    setupApiKey: '',
    setupError: '',
    currentUser: null,
    currentPage: 'home',
    authMode: 'login',
    libraryTab: 'uploaded',
    adminTab: 'dashboard',
    exploreSearch: '',
    exploreSubject: '',
    exploreLevel: '',
    exploreSort: 'recent',
    adminUserSearch: '',
    adminTaskFilter: 'all',

    // Backend refs
    apiKey: '',
    binId: '',

    // In-memory DB (synced with JSONBin)
    db: { users: [], tasks: [], config: {} },

    // Forms
    loginForm: { username: '', password: '' },
    registerForm: { username: '', email: '', password: '', level: '' },
    uploadForm: { title: '', description: '', subject: '', level: '', price: 50, tagsStr: '', hasFile: false },
    profileForm: { bio: '', level: '', avatar: '' },
    configForm: {},
    editUserModal: { open: false, user: null, points: 0, level: '', isAdmin: false },
    taskModal: { open: false, task: null },
    toast: { show: false, message: '', type: 'success' },

    // Static data
    config: {},
    subjects: ['Matemáticas','Física','Química','Historia','Literatura','Biología','Programación','Inglés','Geografía','Filosofía','Arte','Economía'],
    academicLevels: ['Secundaria','Preuniversitario','Universitario 1er año','Universitario 2do año','Universitario 3er año','Posgrado'],
    adminTabs: [
      { id: 'dashboard', label: '📊 Dashboard' },
      { id: 'users', label: '👥 Usuarios' },
      { id: 'tasks', label: '📋 Tareas' },
      { id: 'interface', label: '🎨 Interfaz' },
      { id: 'config', label: '⚙️ Config' },
    ],

    // ---- Computed ----
    get featuredTasks() { return this.db.tasks.filter(t=>t.approved).sort((a,b)=>(b.likes||0)-(a.likes||0)).slice(0,6); },
    get recentTasks() { return this.db.tasks.filter(t=>t.approved).sort((a,b)=>b.createdAt-a.createdAt).slice(0,8); },
    get filteredTasks() {
      let tasks = this.db.tasks.filter(t=>t.approved);
      if (this.exploreSearch) { const q=this.exploreSearch.toLowerCase(); tasks=tasks.filter(t=>t.title.toLowerCase().includes(q)||t.description.toLowerCase().includes(q)||(t.tags||[]).some(tag=>tag.toLowerCase().includes(q))); }
      if (this.exploreSubject) tasks=tasks.filter(t=>t.subject===this.exploreSubject);
      if (this.exploreLevel) tasks=tasks.filter(t=>t.level===this.exploreLevel);
      if (this.exploreSort==='recent') tasks.sort((a,b)=>b.createdAt-a.createdAt);
      if (this.exploreSort==='popular') tasks.sort((a,b)=>(b.likes||0)-(a.likes||0));
      if (this.exploreSort==='price_asc') tasks.sort((a,b)=>a.price-b.price);
      if (this.exploreSort==='price_desc') tasks.sort((a,b)=>b.price-a.price);
      return tasks;
    },
    get myUploadedTasks() { if (!this.currentUser) return []; return this.db.tasks.filter(t=>t.authorId===this.currentUser.id); },
    get myClaimedTasks() { if (!this.currentUser) return []; const ids=this.currentUser.claimedTaskIds||[]; return this.db.tasks.filter(t=>ids.includes(t.id)); },
    get leaderboardUsers() { return [...this.db.users].sort((a,b)=>(b.points||0)-(a.points||0)).slice(0,20); },
    get pendingTasks() { return this.db.tasks.filter(t=>!t.approved); },
    get filteredAdminUsers() { const q=this.adminUserSearch.toLowerCase(); return this.db.users.filter(u=>!q||u.username.toLowerCase().includes(q)||(u.email||'').toLowerCase().includes(q)); },
    get adminFilteredTasks() { if (this.adminTaskFilter==='pending') return this.db.tasks.filter(t=>!t.approved); if (this.adminTaskFilter==='approved') return this.db.tasks.filter(t=>t.approved); return this.db.tasks; },
    get totalPointsInCirculation() { return this.db.users.reduce((sum,u)=>sum+(u.points||0),0); },

    // ---- Init ----
    async init() {
      this.isLoading = true;
      this.loadingMsg = 'Verificando configuración...';

      // Check if already configured
      const savedKey = localStorage.getItem('tc_api_key');
      const savedBin = localStorage.getItem('tc_bin_id');

      if (savedKey && savedBin) {
        this.apiKey = savedKey;
        this.binId = savedBin;
        try {
          await this.loadDB();
          this.setupDone = true;
          this.applyConfig();
          // Restore session
          const sessionId = localStorage.getItem('tc_session');
          if (sessionId) {
            const user = this.db.users.find(u => u.id === sessionId);
            if (user && !user.banned) {
              this.currentUser = user;
              this.initProfileForm();
            }
          }
        } catch(e) {
          // Stored config is invalid, reset
          localStorage.removeItem('tc_api_key');
          localStorage.removeItem('tc_bin_id');
          this.setupDone = false;
        }
      }

      this.isLoading = false;
    },

    async initializeBackend() {
      if (!this.setupApiKey) return;
      this.isLoading = true;
      this.loadingMsg = 'Creando base de datos en JSONBin...';
      this.setupError = '';

      try {
        const initialDB = this.buildInitialDB();
        const id = await jbCreate(this.setupApiKey, initialDB, 'taskcult-db');
        this.apiKey = this.setupApiKey;
        this.binId = id;
        localStorage.setItem('tc_api_key', this.apiKey);
        localStorage.setItem('tc_bin_id', this.binId);
        this.db = initialDB;
        this.applyConfig();
        this.setupDone = true;
        this.showToast('¡Backend inicializado correctamente!', 'success');
      } catch(e) {
        this.setupError = 'Error al conectar con JSONBin. Verificá tu API key e intentá de nuevo. (' + e.message + ')';
      }

      this.isLoading = false;
    },

    buildInitialDB() {
      const cfg = {
        platformName: 'TaskCult',
        platformDescription: 'La economía del conocimiento académico',
        welcomePoints: 100,
        baseUploadPoints: 50,
        pointsPerClaim: 10,
        minPrice: 10,
        maxPrice: 500,
        dailyUploadLimit: 5,
        accentColor: '#6366f1',
        tealColor: '#0d9488',
      };
      const adminUser = {
        id: 'admin-001',
        username: 'admin',
        email: 'admin@taskcult.com',
        password: 'admin123',
        bio: 'Administrador de la plataforma TaskCult.',
        level: 'Posgrado',
        points: 9999,
        tasksUploaded: 5,
        tasksClaimed: 0,
        claimedTaskIds: [],
        likedTaskIds: [],
        transactions: [{ id: 'tx-0', description: 'Cuenta admin creada', amount: 9999, date: Date.now() }],
        isAdmin: true,
        avatar: '',
        createdAt: Date.now(),
        banned: false
      };
      const now = Date.now();
      const sampleTasks = [
        { id: 'task-s1', title: 'Resolución completa de Integrales Dobles con cambio de variable', description: 'Guía exhaustiva con 15 ejercicios resueltos de integrales dobles en coordenadas cartesianas y polares. Incluye cambio de variable, Jacobiano y aplicaciones.', subject: 'Matemáticas', level: 'Universitario 2do año', price: 80, tags:['integral','cálculo','ejercicios'], authorId:'admin-001', authorName:'admin', approved:true, likes:12, views:87, hasFile:true, earnedPoints:80, createdAt:now-86400000*3 },
        { id: 'task-s2', title: 'Apuntes de Mecánica Cuántica: Principio de Heisenberg', description: 'Apuntes detallados sobre el principio de incertidumbre de Heisenberg, con derivaciones matemáticas, ejemplos físicos y análisis filosófico.', subject: 'Física', level: 'Universitario 3er año', price: 120, tags:['cuántica','heisenberg','física moderna'], authorId:'admin-001', authorName:'admin', approved:true, likes:8, views:54, hasFile:true, earnedPoints:120, createdAt:now-86400000*2 },
        { id: 'task-s3', title: 'Análisis completo de La Metamorfosis de Kafka', description: 'Ensayo académico de 10 páginas. Cubre estructura narrativa, simbolismo, alienación como tema central y contexto biográfico de Kafka.', subject: 'Literatura', level: 'Preuniversitario', price: 50, tags:['kafka','ensayo','literatura moderna'], authorId:'admin-001', authorName:'admin', approved:true, likes:19, views:130, hasFile:true, earnedPoints:50, createdAt:now-86400000 },
        { id: 'task-s4', title: 'Proyecto Python: Sistema de gestión de inventario con SQLite', description: 'Código completo y documentado de un sistema de inventario en Python con SQLite, CRUD completo, reportes y autenticación básica.', subject: 'Programación', level: 'Universitario 1er año', price: 150, tags:['python','sqlite','proyecto'], authorId:'admin-001', authorName:'admin', approved:true, likes:33, views:210, hasFile:true, earnedPoints:150, createdAt:now-43200000 },
        { id: 'task-s5', title: 'Línea de tiempo: Primera y Segunda Guerra Mundial', description: 'Presentación con cronología comparativa, causas, consecuencias, mapas y análisis de los tratados de paz de ambas guerras mundiales.', subject: 'Historia', level: 'Secundaria', price: 30, tags:['historia','guerra','siglo XX'], authorId:'admin-001', authorName:'admin', approved:true, likes:5, views:41, hasFile:true, earnedPoints:30, createdAt:now-7200000 },
      ];
      return { users: [adminUser], tasks: sampleTasks, config: cfg };
    },

    async loadDB() {
      this.loadingMsg = 'Cargando datos...';
      this.db = await jbGet(this.binId, this.apiKey);
      // Ensure structure
      if (!this.db.users) this.db.users = [];
      if (!this.db.tasks) this.db.tasks = [];
      if (!this.db.config) this.db.config = {};
    },

    async saveDB() {
      await jbSet(this.binId, this.apiKey, this.db);
    },

    applyConfig() {
      const defaults = { platformName:'TaskCult', platformDescription:'La economía del conocimiento académico', welcomePoints:100, baseUploadPoints:50, pointsPerClaim:10, minPrice:10, maxPrice:500, dailyUploadLimit:5, accentColor:'#6366f1', tealColor:'#0d9488' };
      this.config = { ...defaults, ...(this.db.config || {}) };
      this.configForm = { ...this.config };
      document.documentElement.style.setProperty('--accent', this.config.accentColor || '#6366f1');
      document.documentElement.style.setProperty('--accent-soft', this.shadeColor(this.config.accentColor || '#6366f1', -20));
      document.documentElement.style.setProperty('--teal', this.config.tealColor || '#0d9488');
    },

    shadeColor(color, percent) {
      let num = parseInt(color.replace('#',''), 16);
      let r = Math.max(0, Math.min(255, (num >> 16) + percent));
      let g = Math.max(0, Math.min(255, ((num >> 8) & 0x00FF) + percent));
      let b = Math.max(0, Math.min(255, (num & 0x0000FF) + percent));
      return '#' + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
    },

    // ---- Auth ----
    async doLogin() {
      const user = this.db.users.find(u => (u.username === this.loginForm.username || u.email === this.loginForm.username) && u.password === this.loginForm.password);
      if (!user) { this.showToast('Usuario o contraseña incorrectos.', 'error'); return; }
      if (user.banned) { this.showToast('Tu cuenta ha sido baneada.', 'error'); return; }
      this.currentUser = user;
      localStorage.setItem('tc_session', user.id);
      this.initProfileForm();
      this.showToast('¡Bienvenido, ' + user.username + '!', 'success');
      this.loginForm = { username: '', password: '' };
    },

    async doRegister() {
      if (!this.registerForm.username || !this.registerForm.email || !this.registerForm.password || !this.registerForm.level) { this.showToast('Completá todos los campos.', 'error'); return; }
      if (this.registerForm.password.length < 6) { this.showToast('La contraseña debe tener mínimo 6 caracteres.', 'error'); return; }
      if (this.db.users.find(u => u.username === this.registerForm.username)) { this.showToast('Ese nombre de usuario ya existe.', 'error'); return; }
      if (this.db.users.find(u => u.email === this.registerForm.email)) { this.showToast('Ese email ya está registrado.', 'error'); return; }

      this.isLoading = true;
      this.loadingMsg = 'Creando cuenta...';
      try {
        const wp = this.config.welcomePoints || 100;
        const newUser = {
          id: 'user-' + Date.now(),
          username: this.registerForm.username,
          email: this.registerForm.email,
          password: this.registerForm.password,
          level: this.registerForm.level,
          bio: '',
          points: wp,
          tasksUploaded: 0,
          tasksClaimed: 0,
          claimedTaskIds: [],
          likedTaskIds: [],
          transactions: [{ id:'tx-reg-'+Date.now(), description:'Puntos de bienvenida', amount:wp, date:Date.now() }],
          isAdmin: false,
          avatar: '',
          createdAt: Date.now(),
          banned: false
        };
        this.db.users.push(newUser);
        await this.saveDB();
        this.currentUser = newUser;
        localStorage.setItem('tc_session', newUser.id);
        this.initProfileForm();
        this.showToast('¡Cuenta creada! Recibiste ' + wp + ' pts de bienvenida.', 'success');
        this.registerForm = { username:'', email:'', password:'', level:'' };
      } catch(e) {
        this.showToast('Error al guardar. Intentá de nuevo.', 'error');
      }
      this.isLoading = false;
    },

    doLogout() {
      this.currentUser = null;
      localStorage.removeItem('tc_session');
      this.currentPage = 'home';
    },

    // ---- Tasks ----
    async doUploadTask() {
      if (!this.uploadForm.title || !this.uploadForm.description || !this.uploadForm.subject || !this.uploadForm.level) { this.showToast('Completá todos los campos obligatorios.', 'error'); return; }
      const price = Number(this.uploadForm.price);
      if (!price || price < (this.config.minPrice||10)) { this.showToast('El precio mínimo es ' + (this.config.minPrice||10) + ' puntos.', 'error'); return; }
      if (price > (this.config.maxPrice||500)) { this.showToast('El precio máximo es ' + (this.config.maxPrice||500) + ' puntos.', 'error'); return; }

      this.isLoading = true;
      this.loadingMsg = 'Subiendo tarea...';
      try {
        const tags = this.uploadForm.tagsStr ? this.uploadForm.tagsStr.split(',').map(t=>t.trim().toLowerCase()).filter(Boolean) : [];
        const task = {
          id: 'task-' + Date.now(),
          title: this.uploadForm.title,
          description: this.uploadForm.description,
          subject: this.uploadForm.subject,
          level: this.uploadForm.level,
          price,
          tags,
          authorId: this.currentUser.id,
          authorName: this.currentUser.username,
          approved: !!this.currentUser.isAdmin,
          likes: 0,
          views: 0,
          hasFile: this.uploadForm.hasFile,
          earnedPoints: 0,
          createdAt: Date.now()
        };
        this.db.tasks.push(task);
        const pts = this.config.baseUploadPoints || 50;
        const uIdx = this.db.users.findIndex(u => u.id === this.currentUser.id);
        if (uIdx !== -1) {
          this.db.users[uIdx].points = (this.db.users[uIdx].points || 0) + pts;
          this.db.users[uIdx].tasksUploaded = (this.db.users[uIdx].tasksUploaded || 0) + 1;
          this.db.users[uIdx].transactions = [...(this.db.users[uIdx].transactions || []), { id:'tx-'+Date.now(), description:'Tarea subida: '+task.title.substring(0,40), amount:pts, date:Date.now() }];
        }
        await this.saveDB();
        this.currentUser = this.db.users[uIdx];
        this.showToast('¡Tarea subida! Ganaste ' + pts + ' pts.' + (!this.currentUser.isAdmin ? ' Pendiente de aprobación.' : ''), 'success');
        this.uploadForm = { title:'', description:'', subject:'', level:'', price:50, tagsStr:'', hasFile:false };
        this.setPage('library');
      } catch(e) {
        this.showToast('Error al subir la tarea. Intentá de nuevo.', 'error');
      }
      this.isLoading = false;
    },

    async openTask(task) {
      if (!task) return;
      // Increment views
      const idx = this.db.tasks.findIndex(t => t.id === task.id);
      if (idx !== -1) {
        this.db.tasks[idx].views = (this.db.tasks[idx].views || 0) + 1;
        // Fire and forget view count save
        this.saveDB().catch(() => {});
      }
      this.taskModal.task = { ...task, views: (task.views || 0) + 1 };
      this.taskModal.open = true;
    },

    isTaskClaimed(taskId) {
      if (!this.currentUser || !taskId) return false;
      return (this.currentUser.claimedTaskIds || []).includes(taskId);
    },

    async claimTask(task) {
      if (!task) return;
      if (this.isTaskClaimed(task.id)) { this.showToast('Ya reclamaste esta tarea.', 'warning'); return; }
      if (task.authorId === this.currentUser.id) { this.showToast('No podés reclamar tu propia tarea.', 'warning'); return; }
      if ((this.currentUser.points || 0) < task.price) { this.showToast('No tenés suficientes puntos.', 'error'); return; }

      this.isLoading = true;
      this.loadingMsg = 'Procesando reclamación...';
      try {
        const authorBonus = this.config.pointsPerClaim || 10;
        const claimerIdx = this.db.users.findIndex(u => u.id === this.currentUser.id);
        const authorIdx = this.db.users.findIndex(u => u.id === task.authorId);
        const taskIdx = this.db.tasks.findIndex(t => t.id === task.id);

        if (claimerIdx !== -1) {
          this.db.users[claimerIdx].points -= task.price;
          this.db.users[claimerIdx].claimedTaskIds = [...(this.db.users[claimerIdx].claimedTaskIds || []), task.id];
          this.db.users[claimerIdx].tasksClaimed = (this.db.users[claimerIdx].tasksClaimed || 0) + 1;
          this.db.users[claimerIdx].transactions = [...(this.db.users[claimerIdx].transactions || []), { id:'tx-'+Date.now(), description:'Reclamó tarea: '+task.title.substring(0,40), amount:-task.price, date:Date.now() }];
        }
        if (authorIdx !== -1) {
          this.db.users[authorIdx].points = (this.db.users[authorIdx].points || 0) + task.price + authorBonus;
          this.db.users[authorIdx].transactions = [...(this.db.users[authorIdx].transactions || []), { id:'tx-'+Date.now()+1, description:'Te reclamaron: '+task.title.substring(0,40), amount:task.price+authorBonus, date:Date.now() }];
        }
        if (taskIdx !== -1) {
          this.db.tasks[taskIdx].earnedPoints = (this.db.tasks[taskIdx].earnedPoints || 0) + task.price;
        }
        await this.saveDB();
        if (claimerIdx !== -1) this.currentUser = this.db.users[claimerIdx];
        this.showToast('¡Tarea reclamada! Se descontaron ' + task.price + ' pts.', 'success');
        this.taskModal.open = false;
      } catch(e) {
        this.showToast('Error al reclamar. Intentá de nuevo.', 'error');
      }
      this.isLoading = false;
    },

    downloadTask(task) {
      this.showToast('Descargando: ' + task.title + ' (simulado)', 'success');
    },

    async likeTask(taskId) {
      if (!taskId) return;
      const likedIds = this.currentUser.likedTaskIds || [];
      if (likedIds.includes(taskId)) { this.showToast('Ya le diste like a esta tarea.', 'warning'); return; }

      try {
        const taskIdx = this.db.tasks.findIndex(t => t.id === taskId);
        const userIdx = this.db.users.findIndex(u => u.id === this.currentUser.id);
        if (taskIdx !== -1) this.db.tasks[taskIdx].likes = (this.db.tasks[taskIdx].likes || 0) + 1;
        if (userIdx !== -1) this.db.users[userIdx].likedTaskIds = [...likedIds, taskId];
        await this.saveDB();
        this.currentUser = this.db.users[userIdx];
        if (this.taskModal.task && this.taskModal.task.id === taskId) {
          this.taskModal.task = { ...this.taskModal.task, likes: (this.taskModal.task.likes || 0) + 1 };
        }
        this.showToast('¡Like añadido!', 'success');
      } catch(e) {
        this.showToast('Error al guardar like.', 'error');
      }
    },

    // ---- Admin ----
    async approveTask(taskId) {
      try {
        const idx = this.db.tasks.findIndex(t => t.id === taskId);
        if (idx !== -1) { this.db.tasks[idx].approved = true; await this.saveDB(); }
        this.showToast('Tarea aprobada.', 'success');
      } catch(e) { this.showToast('Error al aprobar.', 'error'); }
    },

    async rejectTask(taskId) {
      try {
        this.db.tasks = this.db.tasks.filter(t => t.id !== taskId);
        await this.saveDB();
        this.showToast('Tarea rechazada y eliminada.', 'warning');
      } catch(e) { this.showToast('Error al rechazar.', 'error'); }
    },

    async adminDeleteTask(taskId) {
      if (!confirm('¿Eliminar esta tarea?')) return;
      try {
        this.db.tasks = this.db.tasks.filter(t => t.id !== taskId);
        await this.saveDB();
        this.showToast('Tarea eliminada.', 'success');
      } catch(e) { this.showToast('Error al eliminar.', 'error'); }
    },

    async toggleBan(userId) {
      try {
        const idx = this.db.users.findIndex(u => u.id === userId);
        if (idx !== -1) {
          this.db.users[idx].banned = !this.db.users[idx].banned;
          await this.saveDB();
          this.showToast(this.db.users[idx].banned ? 'Usuario baneado.' : 'Usuario desbaneado.', 'warning');
        }
      } catch(e) { this.showToast('Error al actualizar usuario.', 'error'); }
    },

    openEditUser(user) {
      this.editUserModal = { open: true, user, points: user.points, level: user.level, isAdmin: user.isAdmin };
    },

    async saveEditUser() {
      try {
        const idx = this.db.users.findIndex(u => u.id === this.editUserModal.user.id);
        if (idx !== -1) {
          this.db.users[idx].points = this.editUserModal.points;
          this.db.users[idx].level = this.editUserModal.level;
          this.db.users[idx].isAdmin = this.editUserModal.isAdmin;
          await this.saveDB();
          if (this.currentUser.id === this.editUserModal.user.id) this.currentUser = this.db.users[idx];
        }
        this.editUserModal.open = false;
        this.showToast('Usuario actualizado.', 'success');
      } catch(e) { this.showToast('Error al guardar.', 'error'); }
    },

    async saveConfig() {
      try {
        this.db.config = { ...this.configForm };
        await this.saveDB();
        this.applyConfig();
        this.showToast('Configuración guardada.', 'success');
      } catch(e) { this.showToast('Error al guardar configuración.', 'error'); }
    },

    // ---- Profile ----
    initProfileForm() {
      this.profileForm = { bio: this.currentUser?.bio || '', level: this.currentUser?.level || '', avatar: this.currentUser?.avatar || '' };
    },

    async saveProfile() {
      try {
        const idx = this.db.users.findIndex(u => u.id === this.currentUser.id);
        if (idx !== -1) {
          this.db.users[idx].bio = this.profileForm.bio;
          this.db.users[idx].level = this.profileForm.level;
          this.db.users[idx].avatar = this.profileForm.avatar;
          await this.saveDB();
          this.currentUser = this.db.users[idx];
        }
        this.showToast('Perfil actualizado.', 'success');
      } catch(e) { this.showToast('Error al guardar perfil.', 'error'); }
    },

    // ---- Utils ----
    setPage(page) { this.currentPage = page; window.scrollTo(0,0); },

    avatarUrl(username) {
      if (!username) return 'https://api.dicebear.com/7.x/shapes/svg?seed=default';
      return `https://api.dicebear.com/7.x/shapes/svg?seed=${encodeURIComponent(username)}&backgroundColor=1a2232,131920,0d1117`;
    },

    subjectClass(subject) {
      const map = { 'Matemáticas':'subject-math','Física':'subject-physics','Química':'subject-chemistry','Historia':'subject-history','Literatura':'subject-literature','Biología':'subject-biology','Programación':'subject-programming','Inglés':'subject-english' };
      return map[subject] || 'subject-other';
    },

    formatDate(ts) {
      if (!ts) return '—';
      return new Date(ts).toLocaleDateString('es-AR', { day:'2-digit', month:'short', year:'numeric' });
    },

    timeAgo(ts) {
      if (!ts) return '';
      const diff = Date.now() - ts;
      const min = Math.floor(diff/60000);
      if (min < 1) return 'ahora';
      if (min < 60) return 'hace ' + min + 'm';
      const hr = Math.floor(min/60);
      if (hr < 24) return 'hace ' + hr + 'h';
      return 'hace ' + Math.floor(hr/24) + 'd';
    },

    showToast(message, type = 'success') {
      this.toast = { show: true, message, type };
      setTimeout(() => { this.toast.show = false; }, 3500);
    },
  };
}
</script>
